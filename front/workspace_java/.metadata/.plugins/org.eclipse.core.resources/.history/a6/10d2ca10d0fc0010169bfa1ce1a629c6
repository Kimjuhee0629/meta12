package exam04;

public class Ex07 {

	public static void main(String[] args) {
		/*
		 등급조건(평균기준)
		 1등급 : 90점이상
		 2등급 : 80점이상
		 3등급 : 70점이상
		 4등급 : 60점이상
		 5등급 : 60점미만
		 89 / 10 = 8
		 85 / 10 = 8
		 81 / 10 = 8
		 80 / 10 = 8
		*/
		double avg = 85.0; // 85 / 10 = 8
		
		switch(avg / 10) {
			case 9:
				System.out.println("1등급");
			case 8:
				System.out.println("2등급");
			case 7:
				System.out.println("3등급");
			case 6:
				System.out.println("4등급");
			default:
				System.out.println("5등급");
		}
		
		System.out.println("-- 프로그램 종료 --");
	}

}
